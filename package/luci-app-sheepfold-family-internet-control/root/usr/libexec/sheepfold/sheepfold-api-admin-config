#!/bin/sh
set -eu

# Authenticated parent-Android configuration API. The public CGI entrypoint
# authenticates the bound administrator device before invoking this helper.
# Writes use one optimistic revision and an isolated UCI delta so a stale APK
# cannot silently overwrite a newer LuCI or administrator change. §apicon1

ACTION="${1:-get}"
UCI_BIN="${SHEEPFOLD_UCI_BIN:-uci}"
ROUTER_CONTROL="${SHEEPFOLD_ROUTER_CONTROL:-/usr/libexec/sheepfold/sheepfold-router-control}"
LOG_HELPER="${SHEEPFOLD_LOG_HELPER:-/usr/libexec/sheepfold/sheepfold-log}"
ADMIN_LOGIN="${SHEEPFOLD_AUTHENTICATED_ADMIN_LOGIN:-}"
LOCK_COMMON="${SHEEPFOLD_LOCK_COMMON:-/usr/libexec/sheepfold/sheepfold-lock-common}"
FORM_COMMON="${SHEEPFOLD_FORM_COMMON:-/usr/libexec/sheepfold/sheepfold-lib-form}"
ADMIN_CONFIG_MODEL="${SHEEPFOLD_ADMIN_CONFIG_MODEL:-/usr/libexec/sheepfold/sheepfold-lib-admin-config-model}"
ADMIN_CONFIG_COMMON="${SHEEPFOLD_ADMIN_CONFIG_COMMON:-/usr/libexec/sheepfold/sheepfold-lib-admin-config-common}"
ADMIN_CONFIG_SCHEDULES="${SHEEPFOLD_ADMIN_CONFIG_SCHEDULES:-/usr/libexec/sheepfold/sheepfold-lib-admin-config-schedules}"
ADMIN_CONFIG_GROUPS="${SHEEPFOLD_ADMIN_CONFIG_GROUPS:-/usr/libexec/sheepfold/sheepfold-lib-admin-config-groups}"
ADMIN_CONFIG_WIFI="${SHEEPFOLD_ADMIN_CONFIG_WIFI:-/usr/libexec/sheepfold/sheepfold-lib-admin-config-wifi}"
ADMIN_CONFIG_NOTIFICATIONS="${SHEEPFOLD_ADMIN_CONFIG_NOTIFICATIONS:-/usr/libexec/sheepfold/sheepfold-lib-admin-config-notifications}"
ADMIN_CONFIG_DEVICES="${SHEEPFOLD_ADMIN_CONFIG_DEVICES:-/usr/libexec/sheepfold/sheepfold-lib-admin-config-devices}"
LOCK_FILE="${SHEEPFOLD_ADMIN_CONFIG_LOCK:-/var/lock/sheepfold-admin-config.flock}"
TRANSACTION_ROOT="${SHEEPFOLD_ADMIN_CONFIG_TX_ROOT:-/tmp/sheepfold/admin-config-transactions}"
CONFIG_FILE="${SHEEPFOLD_CONFIG_FILE:-/etc/config/sheepfold}"
WIRELESS_CONFIG_FILE="${SHEEPFOLD_WIRELESS_CONFIG_FILE:-/etc/config/wireless}"
WIFI_BIN="${SHEEPFOLD_WIFI_BIN:-/sbin/wifi}"
NOT_CONFIGURED_GROUP="${SHEEPFOLD_NOT_CONFIGURED_GROUP:-Not configured}"
SCHEMA_VERSION=1

[ -n "$ADMIN_LOGIN" ] || {
    printf '%s\n' auth_required >&2
    exit 71
}

[ -r "$LOCK_COMMON" ] || {
    printf '%s\n' lock_backend_unavailable >&2
    exit 70
}
. "$LOCK_COMMON"
[ -r "$FORM_COMMON" ] || {
    printf '%s\n' form_decoder_unavailable >&2
    exit 70
}
. "$FORM_COMMON"
[ -r "$ADMIN_CONFIG_MODEL" ] || {
    printf '%s\n' admin_config_model_unavailable >&2
    exit 70
}
. "$ADMIN_CONFIG_MODEL"

# Доменные файлы содержат только определения функций. Их загрузка здесь сохраняет
# одну shell-транзакцию и один namespace, но не смешивает области в одном файле.
for admin_config_module in \
    "$ADMIN_CONFIG_COMMON" \
    "$ADMIN_CONFIG_SCHEDULES" \
    "$ADMIN_CONFIG_GROUPS" \
    "$ADMIN_CONFIG_WIFI" \
    "$ADMIN_CONFIG_NOTIFICATIONS" \
    "$ADMIN_CONFIG_DEVICES"; do
    [ -r "$admin_config_module" ] || {
        printf '%s\n' admin_config_module_unavailable >&2
        exit 70
    }
    . "$admin_config_module"
done
unset admin_config_module

case "$ACTION" in
    get) admin_config_json ;;
    schedule-save) schedule_save ;;
    schedule-delete) schedule_delete ;;
    group-save) group_save ;;
    group-delete) group_delete ;;
    wifi-save) wifi_save ;;
    wifi-control) wifi_control ;;
    wifi-automation-save) wifi_automation_save ;;
    notification-settings-save) notification_settings_save ;;
    device-save) device_save ;;
    *) printf '%s\n' unknown_admin_config_action >&2; exit 2 ;;
esac
