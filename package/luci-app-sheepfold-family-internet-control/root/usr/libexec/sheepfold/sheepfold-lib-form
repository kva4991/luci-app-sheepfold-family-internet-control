#!/bin/sh

# Общая строгая граница application/x-www-form-urlencoded. Ею пользуются и
# обычный Android admin API, и AI Support: повреждённый %XX либо NUL нельзя
# тихо превращать в другое значение внутри POSIX shell. §jsonio1 §apicon1

sheepfold_form_get() {
	local wanted body
	wanted="$1"
	body="$2"

	# Percent-encoding хранит байты, а не Unicode code points. Locale C не даёт
	# awk повторно UTF-8-кодировать байты 0x80..0xFF через sprintf("%c").
	printf '%s\n' "$body" | LC_ALL=C awk -v wanted="$wanted" '
	function hex_value(char) {
		if (char >= "0" && char <= "9")
			return char + 0
		char = toupper(char)
		if (char >= "A" && char <= "F")
			return index("ABCDEF", char) + 9
		return -1
	}

	function decode(value, result, index_value, char, high, low, byte_value) {
		result = ""
		for (index_value = 1; index_value <= length(value); index_value++) {
			char = substr(value, index_value, 1)
			if (char == "+") {
				result = result " "
				continue
			}
			if (char != "%") {
				result = result char
				continue
			}
			if (index_value + 2 > length(value)) {
				decode_error = 1
				return ""
			}
			high = hex_value(substr(value, index_value + 1, 1))
			low = hex_value(substr(value, index_value + 2, 1))
			if (high < 0 || low < 0) {
				decode_error = 1
				return ""
			}
			byte_value = high * 16 + low
			# NUL нельзя представить в POSIX shell-переменной без потери данных.
			if (byte_value == 0) {
				decode_error = 1
				return ""
			}
			result = result sprintf("%c", byte_value)
			index_value += 2
		}
		return result
	}

	{
		# Добавленный printf LF позволяет увидеть даже завершающий сырой LF как NR > 1
		# Сырой control character не является form-urlencoded; %0A в значении допустим
		if (NR > 1 || $0 ~ /[[:cntrl:]]/) {
			decode_error = 1
			exit 2
		}
		remaining = $0
		while (length(remaining)) {
			separator = index(remaining, "&")
			if (separator) {
				item = substr(remaining, 1, separator - 1)
				remaining = substr(remaining, separator + 1)
			} else {
				item = remaining
				remaining = ""
			}

			if (item == "")
				continue

			equals = index(item, "=")
			if (equals) {
				raw_key = substr(item, 1, equals - 1)
				raw_value = substr(item, equals + 1)
			} else {
				raw_key = item
				raw_value = ""
			}

			key = decode(raw_key)
			if (decode_error)
				exit 2
			value = decode(raw_value)
			# Проверяем всю форму до вывода: дубли и повреждённый хвост не должны
			# подтверждать действие уже разобранным первым параметром
			if (decode_error || key == "" || key in seen) {
				decode_error = 1
				exit 2
			}
			seen[key] = 1
			if (key == wanted)
				selected = value
		}
	}

	END {
		if (decode_error)
			exit 2
		printf "%s", selected
	}
	'
}

# Валидация нужна до чтения отдельных полей и до любого изменения настроек
sheepfold_form_validate() {
	sheepfold_form_get '' "$1" >/dev/null
}

# Читает ограниченное CGI-тело в SHEEPFOLD_FORM_BODY. Ошибки: 1 — чтение/длина,
# 2 — превышение лимита, 3 — повреждённая форма. Ответ HTTP остаётся у вызывающего.
# Не полагаемся на set -e: библиотека вызывается из if и command substitution.
sheepfold_form_read_body() {
	local length limit read_status actual_length
	length="${CONTENT_LENGTH:-0}"
	limit="${1:-4096}"
	SHEEPFOLD_FORM_BODY=""
	case "$length" in ''|*[!0-9]*) return 1 ;; esac
	case "$limit" in ''|*[!0-9]*) return 1 ;; esac
	length="$(printf '%s' "$length" | sed 's/^0*//')" || return 1
	length="${length:-0}"
	[ "${#length}" -le "${#limit}" ] || return 2
	[ "$length" -le "$limit" ] || return 2
	read_status=0
	# Sentinel сохраняет сырой завершающий LF; проверка длины также замечает NUL,
	# который shell не способен сохранить, и усечённое тело при успешном dd.
	SHEEPFOLD_FORM_BODY="$(dd bs=1 count="$length" 2>/dev/null; read_status=$?; printf '.'; exit "$read_status")" || read_status=$?
	SHEEPFOLD_FORM_BODY="${SHEEPFOLD_FORM_BODY%.}"
	[ "$read_status" -eq 0 ] || { SHEEPFOLD_FORM_BODY=""; return 1; }
	actual_length="$(printf '%s' "$SHEEPFOLD_FORM_BODY" | wc -c)" || return 1
	[ "$actual_length" -eq "$length" ] || { SHEEPFOLD_FORM_BODY=""; return 1; }
	sheepfold_form_validate "$SHEEPFOLD_FORM_BODY" || { SHEEPFOLD_FORM_BODY=""; return 3; }
	return 0
}
