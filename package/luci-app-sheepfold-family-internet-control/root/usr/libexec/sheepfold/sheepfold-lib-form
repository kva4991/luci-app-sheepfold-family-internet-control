#!/bin/sh

# Общая строгая граница application/x-www-form-urlencoded. Ею пользуются и
# обычный Android admin API, и AI Support: повреждённый %XX либо NUL нельзя
# тихо превращать в другое значение внутри POSIX shell. §jsonio1 §apicon1

sheepfold_form_get() {
	local wanted body
	wanted="$1"
	body="$2"

	# Percent-encoding хранит байты, а не Unicode code points. Locale C не даёт
	# awk повторно UTF-8-кодировать байты 0x80..0xFF через sprintf("%c").
	printf '%s' "$body" | LC_ALL=C awk -v wanted="$wanted" '
	function hex_value(char) {
		if (char >= "0" && char <= "9")
			return char + 0
		char = toupper(char)
		if (char >= "A" && char <= "F")
			return index("ABCDEF", char) + 9
		return -1
	}

	function decode(value, result, index_value, char, high, low, byte_value) {
		result = ""
		for (index_value = 1; index_value <= length(value); index_value++) {
			char = substr(value, index_value, 1)
			if (char == "+") {
				result = result " "
				continue
			}
			if (char != "%") {
				result = result char
				continue
			}
			if (index_value + 2 > length(value)) {
				decode_error = 1
				return ""
			}
			high = hex_value(substr(value, index_value + 1, 1))
			low = hex_value(substr(value, index_value + 2, 1))
			if (high < 0 || low < 0) {
				decode_error = 1
				return ""
			}
			byte_value = high * 16 + low
			# NUL нельзя представить в POSIX shell-переменной без потери данных.
			if (byte_value == 0) {
				decode_error = 1
				return ""
			}
			result = result sprintf("%c", byte_value)
			index_value += 2
		}
		return result
	}

	{
		remaining = $0
		while (length(remaining)) {
			separator = index(remaining, "&")
			if (separator) {
				item = substr(remaining, 1, separator - 1)
				remaining = substr(remaining, separator + 1)
			} else {
				item = remaining
				remaining = ""
			}

			equals = index(item, "=")
			if (equals) {
				raw_key = substr(item, 1, equals - 1)
				raw_value = substr(item, equals + 1)
			} else {
				raw_key = item
				raw_value = ""
			}

			key = decode(raw_key)
			if (decode_error)
				exit 2
			if (key != wanted)
				continue

			value = decode(raw_value)
			if (decode_error)
				exit 2
			printf "%s", value
			found = 1
			exit 0
		}
	}

	END {
		if (decode_error)
			exit 2
	}
	'
}
