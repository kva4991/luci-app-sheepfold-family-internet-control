#!/bin/sh
set -eu

RATE_DIR="${SHEEPFOLD_AI_RATE_DIR:-/tmp/sheepfold/ai-rate}"
JSON_COMMON="${SHEEPFOLD_JSON_COMMON:-/usr/libexec/sheepfold/sheepfold-lib-json}"
UCI_BIN="${SHEEPFOLD_UCI_BIN:-uci}"
ROUTER_CONTROL="${SHEEPFOLD_ROUTER_CONTROL:-/usr/libexec/sheepfold/sheepfold-router-control}"
DEVICE_ID_HELPER="${SHEEPFOLD_DEVICE_ID_HELPER:-/usr/libexec/sheepfold/sheepfold-device-id}"
DHCP_LEASES="${SHEEPFOLD_DHCP_LEASES:-/tmp/dhcp.leases}"
ARP_TABLE="${SHEEPFOLD_ARP_TABLE:-/proc/net/arp}"
mkdir -p "$RATE_DIR"
chmod 700 "$RATE_DIR" 2>/dev/null || true

header_json() {
    printf 'Status: %s\r\n' "$1"
    printf 'Content-Type: application/json; charset=utf-8\r\n'
    printf 'Cache-Control: no-store\r\n'
    [ -z "${2:-}" ] || printf 'Retry-After: %s\r\n' "$2"
    printf '\r\n'
}

reject() {
    header_json "$1" "${4:-}"
    json_init
    json_add_string app sheepfold
    json_add_boolean ok 0
    json_add_string error "$2"
    json_add_string message "$3"
    json_dump
    printf '\n'
    exit 1
}

[ -r "$JSON_COMMON" ] || {
    header_json "500 Internal Server Error"
    printf '{"app":"sheepfold","ok":false,"error":"json_helper_missing"}\n'
    exit 1
}
. "$JSON_COMMON"
sheepfold_json_require || {
    header_json "500 Internal Server Error"
    printf '{"app":"sheepfold","ok":false,"error":"json_parser_unavailable"}\n'
    exit 1
}

normalize_mac() { printf '%s' "$1" | tr 'a-z' 'A-Z'; }
valid_mac() { printf '%s' "$1" | grep -Eq '^([0-9A-F]{2}:){5}[0-9A-F]{2}$'; }
uci_read() { "$UCI_BIN" "$@"; }

mac_for_ip() {
    local ip mac
    ip="$1"
    mac=""
    [ ! -r "$DHCP_LEASES" ] || mac="$(awk -v ip="$ip" '$3 == ip { print toupper($2); exit }' "$DHCP_LEASES")"
    [ -n "$mac" ] || [ ! -r "$ARP_TABLE" ] || mac="$(awk -v ip="$ip" '$1 == ip { print toupper($4); exit }' "$ARP_TABLE")"
    normalize_mac "$mac"
}

device_section_for_mac() {
    local wanted section existing
    wanted="$(normalize_mac "$1")"
    for section in $(uci_read -q show sheepfold 2>/dev/null | sed -n 's/^sheepfold\.\([^.=]*\)=device$/\1/p'); do
        existing="$(uci_read -q get "sheepfold.$section.mac" 2>/dev/null || true)"
        [ "$(normalize_mac "$existing")" = "$wanted" ] || continue
        printf '%s\n' "$section"
        return 0
    done
    return 1
}

list_has_mac() {
    local wanted existing
    wanted="$(normalize_mac "$2")"
    for existing in $(uci_read -q get "sheepfold.$1.mac" 2>/dev/null || true); do
        [ "$(normalize_mac "$existing")" = "$wanted" ] && return 0
    done
    return 1
}

personal_group_for_device() {
    local section mac device_group group_section existing group_name
    section="$1"
    mac="$(normalize_mac "$2")"
    device_group="$(uci_read -q get "sheepfold.$section.group" 2>/dev/null || true)"

    # Детский AI открывается только для устройства, которое родитель явно
    # связал с личной группой. Поддерживаем новую personal_group-модель и
    # текущие group-секции с option personal=1, чтобы миграция была мягкой.
    for group_section in $(uci_read -q show sheepfold 2>/dev/null | sed -n 's/^sheepfold\.\([^.=]*\)=personal_group$/\1/p'); do
        for existing in $(uci_read -q get "sheepfold.$group_section.deviceMac" 2>/dev/null || true); do
            [ "$(normalize_mac "$existing")" = "$mac" ] || continue
            uci_read -q get "sheepfold.$group_section.displayName" 2>/dev/null || \
                uci_read -q get "sheepfold.$group_section.name" 2>/dev/null || \
                printf '%s' "$group_section"
            return 0
        done
    done

    [ -n "$device_group" ] || return 1
    for group_section in $(uci_read -q show sheepfold 2>/dev/null | sed -n 's/^sheepfold\.\([^.=]*\)=group$/\1/p'); do
        [ "$(uci_read -q get "sheepfold.$group_section.personal" 2>/dev/null || printf 0)" = 1 ] || continue
        group_name="$(uci_read -q get "sheepfold.$group_section.name" 2>/dev/null || printf '%s' "$group_section")"
        [ "$device_group" = "$group_section" ] || [ "$device_group" = "$group_name" ] || continue
        printf '%s' "$group_name"
        return 0
    done

    return 1
}

is_admin_request() {
    local device_id mac bearer
    device_id="$1"
    mac="$2"
    bearer=""
    case "${HTTP_AUTHORIZATION:-}" in [Bb]earer\ *) bearer="${HTTP_AUTHORIZATION#* }" ;; esac
    [ -n "$bearer" ] || return 1
    [ "$("$ROUTER_CONTROL" check-token "$bearer" "$device_id" "$mac" 2>/dev/null || printf fail)" = ok ]
}

consume_quota() {
    local identity limit window id file lock tries now started count retry_after
    identity="$1"
    limit="$(uci_read -q get sheepfold.global.ai_rate_limit_requests 2>/dev/null || printf 20)"
    window="$(uci_read -q get sheepfold.global.ai_rate_limit_window_seconds 2>/dev/null || printf 3600)"
    case "$limit" in ''|*[!0-9]*) limit=20 ;; esac
    case "$window" in ''|*[!0-9]*) window=3600 ;; esac
    [ "$limit" -ge 1 ] || limit=1
    [ "$limit" -le 1000 ] || limit=1000
    [ "$window" -ge 60 ] || window=60
    [ "$window" -le 86400 ] || window=86400

    id="$(printf '%s' "$identity" | tr -cd 'A-Za-z0-9_.-')"
    [ -n "$id" ] || id=unknown
    file="$RATE_DIR/$id"
    lock="$file.lock"
    tries=0
    while ! mkdir "$lock" 2>/dev/null; do
        tries=$((tries + 1))
        [ "$tries" -lt 10 ] || return 1
        sleep 1
    done

    now="$(date +%s)"
    started="$now"
    count=0
    [ ! -r "$file" ] || read -r started count < "$file" || true
    case "$started" in ''|*[!0-9]*) started="$now" ;; esac
    case "$count" in ''|*[!0-9]*) count=0 ;; esac
    if [ "$now" -lt "$started" ] || [ $((now - started)) -ge "$window" ]; then
        started="$now"
        count=0
    fi
    if [ "$count" -ge "$limit" ]; then
        retry_after=$((window - (now - started)))
        [ "$retry_after" -gt 0 ] || retry_after=60
        rmdir "$lock" 2>/dev/null || true
        return 1
    fi
    count=$((count + 1))
    printf '%s %s\n' "$started" "$count" > "$file"
    chmod 600 "$file" 2>/dev/null || true
    rmdir "$lock" 2>/dev/null || true
    return 0
}

body="$(cat)"
[ ${#body} -le 16384 ] || reject "413 Payload Too Large" request_too_large "AI request is too large."
[ "$(uci_read -q get sheepfold.global.ai_enabled 2>/dev/null || printf 0)" = 1 ] || \
    reject "503 Service Unavailable" ai_disabled "AI assistant is disabled on the router."

# Все поля проходят одну строгую form-границу до аутентификации и списания
# квоты. Иначе повреждённое позднее поле расходует лимит или падает как команда.
requested_device_id="$(sheepfold_form_get deviceId "$body")" || \
    reject "400 Bad Request" invalid_form_encoding "The request contains invalid form encoding."
requested_role="$(sheepfold_form_get clientRole "$body")" || \
    reject "400 Bad Request" invalid_form_encoding "The request contains invalid form encoding."
requested_admin="$(sheepfold_form_get isAdministrator "$body")" || \
    reject "400 Bad Request" invalid_form_encoding "The request contains invalid form encoding."
consent_version="$(sheepfold_form_get consentVersion "$body")" || \
    reject "400 Bad Request" invalid_form_encoding "The request contains invalid form encoding."
include_info="$(sheepfold_form_get includeInfo "$body")" || \
    reject "400 Bad Request" invalid_form_encoding "The request contains invalid form encoding."
include_logs="$(sheepfold_form_get includeLogs "$body")" || \
    reject "400 Bad Request" invalid_form_encoding "The request contains invalid form encoding."
google_account="$(sheepfold_form_get googleAccount "$body")" || \
    reject "400 Bad Request" invalid_form_encoding "The request contains invalid form encoding."
provider="$(sheepfold_form_get provider "$body")" || \
    reject "400 Bad Request" invalid_form_encoding "The request contains invalid form encoding."
model="$(sheepfold_form_get model "$body")" || \
    reject "400 Bad Request" invalid_form_encoding "The request contains invalid form encoding."
[ -n "$requested_device_id" ] || reject "400 Bad Request" device_id_required "Device id is required."
[ -n "$requested_role" ] || reject "400 Bad Request" client_role_required "Client role is required."

remote_ip="${REMOTE_ADDR:-}"
mac="$(mac_for_ip "$remote_ip")"
valid_mac "$mac" || reject "403 Forbidden" device_not_resolved "The router could not identify this LAN device."

admin_request=0
if is_admin_request "$requested_device_id" "$mac"; then
    admin_request=1
fi
list_has_mac blocklist "$mac" && reject "403 Forbidden" device_blocklisted "Blocked devices cannot use the AI assistant."
device_section="$(device_section_for_mac "$mac" 2>/dev/null || true)"
[ -n "$device_section" ] || reject "403 Forbidden" device_not_registered "This device is not registered in Sheepfold."
server_device_id="$("$DEVICE_ID_HELPER" ensure "$device_section" 2>/dev/null || true)"
[ -n "$server_device_id" ] || reject "500 Internal Server Error" device_id_missing "The router could not assign a numeric device id."
server_legacy_ids="$(uci_read -q get "sheepfold.$device_section.legacy_ids" 2>/dev/null || true)"
server_admin="$(uci_read -q get "sheepfold.$device_section.admin_device" 2>/dev/null || printf 0)"

# Старый ID допустим только у той же MAC-секции; это сохраняет сопряжение после
# миграции старого строкового формата номера, не ослабляя проверку устройства. §deviceid2
case " $server_device_id $server_legacy_ids " in
    *" $requested_device_id "*) ;;
    *) reject "403 Forbidden" device_identity_mismatch "Device id does not match the LAN device." ;;
esac

if [ "$admin_request" = 1 ]; then
    [ "$server_admin" = 1 ] || reject "403 Forbidden" administrator_device_required "Administrator token must be used from its paired device."
    case "$requested_role" in parent|administrator) ;;
        *) reject "403 Forbidden" client_role_mismatch "Administrator request must use the parent role." ;;
    esac
    [ "$requested_admin" = 1 ] || reject "403 Forbidden" administrator_flag_mismatch "Administrator flag does not match the verified device."
else
    [ "${HTTP_X_SHEEPFOLD_CLIENT:-}" = "android-child-v1" ] || \
        reject "403 Forbidden" client_header_required "A Sheepfold child client marker is required."
    [ "$server_admin" != 1 ] || reject "403 Forbidden" client_role_mismatch "Administrator devices must use an administrator token."
    [ "$requested_role" = child ] || reject "403 Forbidden" client_role_mismatch "Child device must use the child role."
    [ "$requested_admin" = 0 ] || reject "403 Forbidden" administrator_flag_mismatch "Administrator flag does not match the verified device."
    [ "$consent_version" = child-ai-v1 ] || reject "403 Forbidden" parental_consent_version_required "The current parental consent version is required."
    [ "$(uci_read -q get sheepfold.global.child_ai_parental_consent 2>/dev/null || printf 0)" = 1 ] || \
        reject "403 Forbidden" parental_consent_required "A parent must enable child AI access in Sheepfold settings."
    personal_group_for_device "$device_section" "$mac" >/dev/null || \
        reject "403 Forbidden" personal_group_required "Ask a parent to put this device into your personal group in Sheepfold settings."
fi

consume_quota "$server_device_id" || reject "429 Too Many Requests" rate_limited "AI request limit reached for this device." "${retry_after:-3600}"

if [ "$include_info" = 1 ] || [ "$include_logs" = 1 ] || [ -n "$google_account" ] || [ -n "$provider" ] || [ -n "$model" ]; then
    [ "$admin_request" = 1 ] || reject "403 Forbidden" privileged_context_forbidden "Diagnostics, logs, account data, and provider overrides require an administrator token."
fi

if [ "$include_logs" = 1 ] && [ "$(uci_read -q get sheepfold.global.ai_individual_logs 2>/dev/null || printf 0)" != 1 ]; then
    reject "403 Forbidden" individual_logs_disabled "Individual AI log context is disabled."
fi

exit 0
