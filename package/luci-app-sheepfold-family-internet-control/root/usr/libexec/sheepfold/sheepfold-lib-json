#!/bin/sh

# Общая AI-only граница JSON для CGI Sheepfold. JSON строится штатным jshn,
# а общий для обеих редакций form-decoder подключается отдельной библиотекой. §jsonio1

SHEEPFOLD_JSHN_LIB="${SHEEPFOLD_JSHN_LIB:-/usr/share/libubox/jshn.sh}"
SHEEPFOLD_FORM_COMMON="${SHEEPFOLD_FORM_COMMON:-/usr/libexec/sheepfold/sheepfold-lib-form}"

[ -r "$SHEEPFOLD_FORM_COMMON" ] || {
	printf '%s\n' form_decoder_unavailable >&2
	return 1 2>/dev/null || exit 1
}
. "$SHEEPFOLD_FORM_COMMON"

sheepfold_json_require() {
	[ -r "$SHEEPFOLD_JSHN_LIB" ] || return 1
	# shellcheck source=/usr/share/libubox/jshn.sh
	. "$SHEEPFOLD_JSHN_LIB"
	command -v json_init >/dev/null 2>&1 &&
		command -v json_add_string >/dev/null 2>&1 &&
		command -v json_add_boolean >/dev/null 2>&1 &&
		command -v json_add_object >/dev/null 2>&1 &&
		command -v json_add_array >/dev/null 2>&1 &&
		command -v json_close_object >/dev/null 2>&1 &&
		command -v json_close_array >/dev/null 2>&1 &&
		command -v json_add_double >/dev/null 2>&1 &&
		command -v json_dump >/dev/null 2>&1
}

sheepfold_gemini_payload() {
	json_init
	json_add_object systemInstruction
	json_add_array parts
	json_add_object ""
	json_add_string text "$1"
	json_close_object
	json_close_array
	json_close_object
	json_add_array contents
	json_add_object ""
	json_add_string role user
	json_add_array parts
	json_add_object ""
	json_add_string text "$2"
	json_close_object
	json_close_array
	json_close_object
	json_close_array
	json_add_object generationConfig
	json_add_double temperature 0.4
	json_close_object
	json_dump
}

sheepfold_chat_payload() {
	json_init
	json_add_string model "$1"
	json_add_array messages
	json_add_object ""
	json_add_string role system
	json_add_string content "$2"
	json_close_object
	json_add_object ""
	json_add_string role user
	json_add_string content "$3"
	json_close_object
	json_close_array
	json_add_double temperature 0.4
	json_dump
}
