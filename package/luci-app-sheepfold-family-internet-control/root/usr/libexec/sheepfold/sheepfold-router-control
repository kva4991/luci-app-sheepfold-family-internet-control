#!/bin/sh
set -eu

. /usr/libexec/sheepfold/sheepfold-token-common

LEGACY="/usr/libexec/sheepfold/sheepfold-router-control-legacy"
PAIR_DEVICE="/usr/libexec/sheepfold/sheepfold-pair-device"
PAIR_ACTIVATE="/usr/libexec/sheepfold/sheepfold-pair-activate"
CLIENT_STATUS="/usr/libexec/sheepfold/sheepfold-client-status-effective"
DEVICE_RECLASSIFY="/usr/libexec/sheepfold/sheepfold-device-reclassify"
DEVICE_PRESENCE="/usr/libexec/sheepfold/sheepfold-device-presence"
LED_CONTROL="/usr/libexec/sheepfold/sheepfold-led-control"
FEEDBACK="/usr/libexec/sheepfold/sheepfold-feedback"
IPV6_CONTROL="/usr/libexec/sheepfold/sheepfold-ipv6-control"
CHILD_WIFI_MONITOR="/usr/libexec/sheepfold/sheepfold-child-wifi-monitor"
TLS_FINGERPRINT="/usr/libexec/sheepfold/sheepfold-tls-fingerprint"
LOG_HELPER="/usr/libexec/sheepfold/sheepfold-log"
TOKEN_STATE_DIR="/etc/sheepfold/tokens"
TOKEN_RUNTIME_LINK="/tmp/sheepfold/tokens"

if [ "${1:-}" = "--luci" ]; then
    # Доверяем маркеру только внутри rpcd ACL: публичный Sheepfold API не
    # прокидывает его и ведёт собственную аутентификацию/атрибуцию. §logaudit
    SHEEPFOLD_ACTION_ACTOR='LuCI (Изменено на роутере)'
    export SHEEPFOLD_ACTION_ACTOR
    shift
fi
command="${1:-status}"

root_password_status() {
    password_field="$(awk -F: '$1 == "root" { print $2; exit }' /etc/shadow 2>/dev/null || true)"
    case "$password_field" in
        ''|'!'|'*'|'!!'|'x') printf 'unset\n' ;;
        *) printf 'set\n' ;;
    esac
}

ensure_token_storage() {
    umask 077
    mkdir -p /etc/sheepfold "$TOKEN_STATE_DIR" /tmp/sheepfold
    chmod 700 /etc/sheepfold "$TOKEN_STATE_DIR" 2>/dev/null || true

    if [ -L "$TOKEN_RUNTIME_LINK" ]; then
        if [ "$(readlink "$TOKEN_RUNTIME_LINK" 2>/dev/null || true)" = "$TOKEN_STATE_DIR" ]; then
            return 0
        fi
        rm -f "$TOKEN_RUNTIME_LINK"
    elif [ -d "$TOKEN_RUNTIME_LINK" ]; then
        for token_file in "$TOKEN_RUNTIME_LINK"/*; do
            [ -f "$token_file" ] || continue
            cp -p "$token_file" "$TOKEN_STATE_DIR/" 2>/dev/null || true
        done
        rm -rf "$TOKEN_RUNTIME_LINK"
    elif [ -e "$TOKEN_RUNTIME_LINK" ]; then
        rm -f "$TOKEN_RUNTIME_LINK"
    fi

    ln -s "$TOKEN_STATE_DIR" "$TOKEN_RUNTIME_LINK"
}

sha256_value() {
    if command -v sha256sum >/dev/null 2>&1; then
        printf '%s' "$1" | sha256sum | cut -d' ' -f1
    elif command -v openssl >/dev/null 2>&1; then
        printf '%s' "$1" | openssl dgst -sha256 | awk '{print $NF}'
    else
        echo "SHA-256 implementation is unavailable." >&2
        return 1
    fi
}

check_token() {
    local bearer client_device_id client_mac token_file hash now section login
    bearer="${1:-}"
    client_device_id="${2:-}"
    client_mac="${3:-}"

    [ -n "$bearer" ] || { printf 'fail\n'; return 0; }

    for section in $(uci -q show sheepfold 2>/dev/null | sed -n 's/^sheepfold\.\([^.=]*\)=administrator$/\1/p'); do
        login="$(uci -q get "sheepfold.$section.login" 2>/dev/null || true)"
        [ -n "$login" ] || continue
        hash="$(sha256_value "$login:$bearer")" || { printf 'fail\n'; return 0; }
        token_file="$TOKEN_STATE_DIR/$hash"
        [ -f "$token_file" ] || continue
        now="$(date +%s)"
        if token_bound_file_valid "$token_file" "$client_device_id" "$client_mac" "$now"; then
            printf 'ok\n'
            return 0
        fi
        printf 'fail\n'
        return 0
    done

    printf 'fail\n'
}

authenticate_token() {
    local bearer client_ip token_file hash now file_login device_id mac issued_at expires_at section login
    bearer="${1:-}"
    client_ip="${2:-}"

    [ -n "$bearer" ] || return 2
    [ -n "$client_ip" ] || return 3

    for section in $(uci -q show sheepfold 2>/dev/null | sed -n 's/^sheepfold\.\([^.=]*\)=administrator$/\1/p'); do
        login="$(uci -q get "sheepfold.$section.login" 2>/dev/null || true)"
        [ -n "$login" ] || continue
        hash="$(sha256_value "$login:$bearer")" || return 2
        token_file="$TOKEN_STATE_DIR/$hash"
        [ -f "$token_file" ] || continue

        # uhttpd на части OpenWrt-сборок не передаёт произвольные X-Sheepfold-*
        # заголовки CGI. Поэтому доверенные ID и MAC берём только из серверной
        # записи токена, а телефон предъявляет один Bearer. §pairtx1 §authrs1
        token_file_is_legacy "$token_file" && return 4
        file_login="$(token_file_get "$token_file" login)"
        device_id="$(token_file_get "$token_file" device_id)"
        mac="$(token_normalize_mac "$(token_file_get "$token_file" mac)")"
        issued_at="$(token_file_get "$token_file" issued_at)"
        expires_at="$(token_file_get "$token_file" expires_at)"

        [ "$file_login" = "$login" ] || return 4
        [ -n "$device_id" ] || return 4
        token_valid_mac "$mac" || return 4
        case "$issued_at" in ''|*[!0-9]*) return 4 ;; esac
        case "$expires_at" in ''|*[!0-9]*) return 4 ;; esac
        now="$(date +%s)"
        [ "$expires_at" -le 0 ] || [ "$now" -le "$expires_at" ] || return 2
        token_device_is_admin_paired "$device_id" "$mac" || return 4
        token_request_source_matches "$client_ip" "$mac" || return 3

        printf 'login=%s\ndevice_id=%s\nmac=%s\n' "$login" "$device_id" "$mac"
        return 0
    done

    return 2
}

token_login() {
    local bearer client_device_id client_mac section login hash token_file
    bearer="${1:-}"
    client_device_id="${2:-}"
    client_mac="${3:-}"

    [ -n "$bearer" ] || return 1
    for section in $(uci -q show sheepfold 2>/dev/null | sed -n 's/^sheepfold\.\([^.=]*\)=administrator$/\1/p'); do
        login="$(uci -q get "sheepfold.$section.login" 2>/dev/null || true)"
        [ -n "$login" ] || continue
        hash="$(sha256_value "$login:$bearer")" || return 1
        token_file="$TOKEN_STATE_DIR/$hash"
        [ -f "$token_file" ] || continue
        if token_bound_file_valid "$token_file" "$client_device_id" "$client_mac" "$(date +%s)"; then
            printf '%s\n' "$login"
            return 0
        fi
        return 1
    done
    return 1
}

revoke_tokens() {
    local login token_file file_login revoked actor
    login="${1:-}"
    revoked=0

    if [ -z "$login" ]; then
        for token_file in "$TOKEN_STATE_DIR"/*; do
            [ -f "$token_file" ] || continue
            rm -f "$token_file" 2>/dev/null || true
            revoked=$((revoked + 1))
        done
        printf 'revoked=%s\n' "$revoked"
        return 0
    fi

    for token_file in "$TOKEN_STATE_DIR"/*; do
        [ -f "$token_file" ] || continue
        if token_file_is_legacy "$token_file"; then
            continue
        fi
        file_login="$(token_file_get "$token_file" login)"
        [ "$file_login" = "$login" ] || continue
        rm -f "$token_file" 2>/dev/null || true
        revoked=$((revoked + 1))
    done

    actor="${SHEEPFOLD_ACTION_ACTOR:-Sheepfold API}"
    if [ -x "$LOG_HELPER" ]; then
        "$LOG_HELPER" "$actor: завершены все телефонные сеансы администратора $login; отозвано токенов: $revoked" >/dev/null 2>&1 || true
    fi
    printf 'revoked=%s\n' "$revoked"
}

revoke_device_tokens() {
    local device_id token_file file_device_id
    device_id="${1:-}"

    [ -n "$device_id" ] || return 1
    for token_file in "$TOKEN_STATE_DIR"/*; do
        [ -f "$token_file" ] || continue
        if token_file_is_legacy "$token_file"; then
            continue
        fi
        file_device_id="$(token_file_get "$token_file" device_id)"
        [ "$file_device_id" = "$device_id" ] || continue
        rm -f "$token_file" 2>/dev/null || true
    done
}

ensure_token_storage

case "$command" in
    root-password-status)
        root_password_status
        ;;
    check-token)
        check_token "${2:-}" "${3:-}" "${4:-}"
        ;;
    authenticate-token)
        authenticate_token "${2:-}" "${3:-}"
        ;;
    token-login)
        token_login "${2:-}" "${3:-}" "${4:-}"
        ;;
    revoke-tokens)
        revoke_tokens "${2:-}"
        ;;
    revoke-device-tokens)
        revoke_device_tokens "${2:-}"
        ;;
    pair-admin-device)
        shift
        exec "$PAIR_DEVICE" "$@"
        ;;
    activate-admin-pairing-code)
        shift
        exec "$PAIR_ACTIVATE" "$@"
        ;;
    client-status)
        shift
        exec "$CLIENT_STATUS" "$@"
        ;;
    device-reclassify)
        shift
        exec "$DEVICE_RECLASSIFY" "$@"
        ;;
    device-presence)
        shift
        exec "$DEVICE_PRESENCE" "$@"
        ;;
    led-dependency-status)
        exec "$LED_CONTROL" dependency-status
        ;;
    led-dependency-install)
        exec "$LED_CONTROL" dependency-install
        ;;
    led-repair-status)
        exec "$LED_CONTROL" repair-status
        ;;
    led-repair-apply)
        exec "$LED_CONTROL" repair-apply
        ;;
    led-apply)
        exec "$LED_CONTROL" apply
        ;;
    feedback-status)
        exec "$FEEDBACK" status
        ;;
    feedback-submit)
        shift
        exec "$FEEDBACK" submit "$@"
        ;;
    ipv6-apply)
        exec "$IPV6_CONTROL" apply
        ;;
    ipv6-status)
        exec "$IPV6_CONTROL" status
        ;;
    ipv6-release)
        exec "$IPV6_CONTROL" release
        ;;
    child-wifi-history-clear)
        exec "$CHILD_WIFI_MONITOR" clear
        ;;
    tls-public-key-fingerprint)
        exec "$TLS_FINGERPRINT"
        ;;
    *)
        exec "$LEGACY" "$@"
        ;;
esac
