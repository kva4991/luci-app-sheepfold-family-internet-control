#!/bin/sh
set -eu

. /usr/libexec/sheepfold/sheepfold-pair-diagnostics
. /usr/libexec/sheepfold/sheepfold-lib-form

. /usr/libexec/sheepfold/sheepfold-pair-attempt-common
PAIR_LOG_HELPER="/usr/libexec/sheepfold/sheepfold-log"
trap 'pair_attempt_cleanup' EXIT
trap 'exit 1' HUP INT TERM

json_escape() {
    printf '%s' "$1" | tr '\n\r\t' '   ' | sed 's/\\/\\\\/g; s/"/\\"/g'
}

# Сопряжение использует ту же строгую границу, что и обычные команды Android.
# Локальный printf %b декодировал также literal backslash и пропускал битый хвост.
form_get() {
    sheepfold_form_get "$1" "$2"
}

kv_get() {
    key="$1"
    printf '%s\n' "$2" | sed -n "s/^$key=//p" | sed -n '1p'
}

header_json() {
    printf 'Status: %s\r\n' "$1"
    printf 'Content-Type: application/json; charset=utf-8\r\n'
    printf 'Cache-Control: no-store\r\n'
    [ -z "${2:-}" ] || printf 'Retry-After: %s\r\n' "$2"
    printf '\r\n'
}

read_body() {
    read_status=0
    sheepfold_form_read_body 4096 || read_status=$?
    case "$read_status" in
        0) body="$SHEEPFOLD_FORM_BODY"; return 0 ;;
        2) http_status="413 Payload Too Large"; error_code="request_too_large" ;;
        3) http_status="400 Bad Request"; error_code="invalid_form" ;;
        *) http_status="400 Bad Request"; error_code="body_read_failed" ;;
    esac
    # Ошибку публикует основной CGI, а не subshell, чей exit раньше терялся.
    header_json "$http_status"
    printf '{"app":"sheepfold","ok":false,"paired":false,"error":"%s"}\n' "$error_code"
    exit 0
}

valid_pairing_code() {
    code_rest="$1"
    [ -n "$code_rest" ] || return 1
    while [ -n "$code_rest" ]; do
        code_char="${code_rest%"${code_rest#?}"}"
        case "$code_char" in
            [A-Za-z0-9]|'+'|'-'|'*'|'('|')'|'['|']'|'{'|'}'|'<'|'>'|'?'|'@'|'#'|'$'|'%'|'^'|'&'|':'|';'|'.'|',') ;;
            *) return 1 ;;
        esac
        code_rest="${code_rest#?}"
    done
    return 0
}

attempt_identity() {
    ip="${REMOTE_ADDR:-unknown}"
    mac=""
    if [ -r /tmp/dhcp.leases ]; then
        mac="$(awk -v ip="$ip" '$3 == ip { print toupper($2); exit }' /tmp/dhcp.leases)"
    fi
    if [ -z "$mac" ] && [ -r /proc/net/arp ]; then
        mac="$(awk -v ip="$ip" '$1 == ip { print toupper($4); exit }' /proc/net/arp)"
    fi
    printf '%s' "${mac:-$ip}" | tr -cd 'A-Za-z0-9_.-'
}

pair_attempt_unavailable() {
    header_json "503 Service Unavailable"
    printf '{"app":"sheepfold","ok":false,"paired":false,"error":"pairing_attempts_unavailable"}\n'
    exit 0
}

log_pairing_failure() {
    local failure_code failure_ip failure_text
    failure_code="$1"
    failure_ip="${REMOTE_ADDR:-не определён}"
    case "$failure_code" in
        device_not_resolved) failure_text="Роутер пока не определил устройство в локальной сети" ;;
        device_blocklisted) failure_text="Устройство находится в чёрном списке устройств" ;;
        token_generation_failed) failure_text="Не удалось создать или сохранить административный токен" ;;
        *) failure_text="Одноразовый код отклонён" ;;
    esac

    # Код сопряжения и внутренний вывод намеренно не попадают в журнал. §pairrng1
    if [ -x "$PAIR_LOG_HELPER" ]; then
        "$PAIR_LOG_HELPER" "Не удалось привязать устройство администратора: $failure_text, IP $failure_ip" \
            >/dev/null 2>&1 && return 0
    fi
    # Журнал не меняет отказ привязки и не печатает посторонний текст в CGI.
    logger -t sheepfold-router-pairing "Pairing failed: $failure_code, IP $failure_ip" \
        >/dev/null 2>&1 || printf 'Sheepfold pairing journal unavailable\n' >&2
    return 0
}

if [ "${REQUEST_METHOD:-POST}" = "OPTIONS" ]; then
    pair_diag_event api_options "remote_ip=${REMOTE_ADDR:-unknown}"
    header_json "204 No Content"
    exit 0
fi

if [ "${REQUEST_METHOD:-POST}" != "POST" ]; then
    pair_diag_event api_rejected "reason=method_not_allowed" "method=${REQUEST_METHOD:-unknown}" "remote_ip=${REMOTE_ADDR:-unknown}"
    header_json "405 Method Not Allowed"
    printf '{"app":"sheepfold","ok":false,"paired":false,"error":"method_not_allowed"}\n'
    exit 0
fi

if [ "${HTTP_X_SHEEPFOLD_CLIENT:-}" != "android-admin-v1" ] && \
   [ "${HTTP_USER_AGENT:-}" != "Sheepfold Android" ]; then
    pair_diag_event api_rejected "reason=client_header_required" "remote_ip=${REMOTE_ADDR:-unknown}"
    header_json "403 Forbidden"
    printf '{"app":"sheepfold","ok":false,"paired":false,"error":"client_header_required"}\n'
    exit 0
fi

pair_diag_event api_received \
    "remote_ip=${REMOTE_ADDR:-unknown}" \
    "content_length=${CONTENT_LENGTH:-0}" \
    "client_header=${HTTP_X_SHEEPFOLD_CLIENT:-missing}"
read_body
login="$(form_get login "$body")"
code="$(form_get code "$body")"
pair_diag_event api_form_parsed \
    "remote_ip=${REMOTE_ADDR:-unknown}" \
    "login_present=$([ -n "$login" ] && printf yes || printf no)" \
    "code_length=${#code}"

if [ -z "$login" ] || [ -z "$code" ]; then
    pair_diag_event api_rejected "reason=login_and_code_required" "remote_ip=${REMOTE_ADDR:-unknown}"
    header_json "400 Bad Request"
    printf '{"app":"sheepfold","ok":false,"paired":false,"error":"login_and_code_required"}\n'
    exit 0
fi

case "$login" in *[!A-Za-z0-9_.@+-]*|'')
    pair_diag_event api_rejected "reason=invalid_login" "remote_ip=${REMOTE_ADDR:-unknown}"
    header_json "400 Bad Request"
    printf '{"app":"sheepfold","ok":false,"paired":false,"error":"invalid_login"}\n'
    exit 0
    ;;
esac
if ! valid_pairing_code "$code" || [ ${#code} -lt 4 ] || [ ${#code} -gt 64 ]; then
    pair_diag_event api_rejected "reason=invalid_code_format" "remote_ip=${REMOTE_ADDR:-unknown}" "code_length=${#code}"
    header_json "400 Bad Request"
    printf '{"app":"sheepfold","ok":false,"paired":false,"error":"invalid_code"}\n'
    exit 0
fi

attempt_identity_value="$(attempt_identity)" || pair_attempt_unavailable
attempt_status=0
pair_attempt_reserve "$attempt_identity_value" || attempt_status="$?"
case "$attempt_status" in
    0) ;;
    1)
        pair_diag_event api_rejected "reason=rate_limited" "remote_ip=${REMOTE_ADDR:-unknown}" "retry_after=$PAIR_ATTEMPT_RETRY"
        header_json "429 Too Many Requests" "$PAIR_ATTEMPT_RETRY"
        printf '{"app":"sheepfold","ok":false,"paired":false,"error":"rate_limited","message":"Too many pairing attempts. Try again later."}\n'
        exit 0 ;;
    *) pair_attempt_unavailable ;;
esac

status=0
pair_started_at="$PAIR_ATTEMPT_NOW"
pair_diag_event backend_started "remote_ip=${REMOTE_ADDR:-unknown}"
# FD закрыт и в capture-shell: фоновые потомки backend не наследуют наш lock.
output="$(exec 9>&-; /usr/libexec/sheepfold/sheepfold-router-control pair-admin-device \
    "$login" "$code" "${REMOTE_ADDR:-}" "${HTTP_USER_AGENT:-Android Sheepfold}" 9>&- 2>&1)" || status="$?"
# Не даём необязательному таймеру отменить уже сохранённую привязку.
pair_finished_at="$(date +%s 2>/dev/null)" || pair_finished_at="$pair_started_at"
pair_finished_at="$(pair_attempt_uint "$pair_finished_at" 10)" || pair_finished_at="$pair_started_at"
pair_diag_event backend_finished \
    "remote_ip=${REMOTE_ADDR:-unknown}" \
    "status=$status" \
    "duration_seconds=$((pair_finished_at - pair_started_at))"

if [ "$status" != "0" ]; then
    case "$status" in
        # Только эти коды означают проверенный отказ credentials; слот уже учтён.
        2|3) http_status="403 Forbidden"; error_code="pairing_rejected" ;;
        *)
            pair_attempt_refund || pair_attempt_unavailable
            case "$status" in
                4) http_status="409 Conflict"; error_code="device_not_resolved" ;;
                5) http_status="403 Forbidden"; error_code="device_blocklisted" ;;
                6) http_status="500 Internal Server Error"; error_code="token_generation_failed" ;;
                7) http_status="409 Conflict"; error_code="pairing_busy" ;;
                *) http_status="503 Service Unavailable"; error_code="pairing_backend_unavailable" ;;
            esac ;;
    esac
    pair_attempt_cleanup
    pair_diag_event api_response "remote_ip=${REMOTE_ADDR:-unknown}" "result=$error_code" "status=$status"
    log_pairing_failure "$error_code"
    header_json "$http_status"
    printf '{"app":"sheepfold","ok":false,"paired":false,"error":"%s","message":"%s"}\n' \
        "$error_code" "$(json_escape "$output")"
    exit 0
fi

# Backend уже сжёг одноразовый код и сохранил токен. Ошибка уборки счётчика не
# должна скрыть успешный результат от APK и потерять только что выданный токен.
pair_attempt_clear || printf 'Sheepfold pairing counter cleanup failed\n' >&2
pair_attempt_cleanup
pair_diag_event api_response "remote_ip=${REMOTE_ADDR:-unknown}" "result=paired" "status=0"
header_json "200 OK"
printf '{"app":"sheepfold","ok":true,"paired":true,'
printf '"routerName":"%s",' "$(json_escape "$(uci -q get system.@system[0].hostname 2>/dev/null || printf OpenWrt)")"
printf '"adminName":"%s",' "$(json_escape "$(kv_get admin_name "$output")")"
printf '"adminLogin":"%s",' "$(json_escape "$(kv_get admin_login "$output")")"
printf '"deviceId":"%s",' "$(json_escape "$(kv_get device_id "$output")")"
printf '"deviceName":"%s",' "$(json_escape "$(kv_get device_name "$output")")"
printf '"mac":"%s",' "$(json_escape "$(kv_get mac "$output")")"
printf '"ip":"%s",' "$(json_escape "$(kv_get ip "$output")")"
printf '"token":"%s"}\n' "$(json_escape "$(kv_get token "$output")")"
