#!/bin/sh

# Wi-Fi редактор, управление радиомодулями и общее расписание Wi-Fi.\n# /etc/config/wireless имеет отдельный снимок и проверяемый rollback. §apicon1

WIFI_TX_SNAPSHOT=""
WIFI_TX_DIR=""
WIFI_TX_RESTORE=0
WIFI_TX_ACTIVE=0

# Два ограниченных read-only RPC на радио, без сканирования эфира и записи во flash
wifi_channel_list() (
    local radio band payload phy keys key channel mhz restricted count
    radio="$1"
    valid_section_name "$radio" || exit 0
    [ -r "${SHEEPFOLD_JSHN_LIB:-/usr/share/libubox/jshn.sh}" ] || exit 0
    . "${SHEEPFOLD_JSHN_LIB:-/usr/share/libubox/jshn.sh}"
    payload="$("${SHEEPFOLD_UBUS_BIN:-ubus}" -t 1 call iwinfo phyname "{\"section\":\"$radio\"}" 2>/dev/null | head -c 4097)"
    [ "${#payload}" -le 4096 ] || exit 0
    json_load "$payload" >/dev/null 2>&1 || exit 0
    json_get_var phy phyname || exit 0
    case "$phy" in ''|*[!a-zA-Z0-9_.-]*) exit 0 ;; esac
    payload="$("${SHEEPFOLD_UBUS_BIN:-ubus}" -t 1 call iwinfo freqlist "{\"device\":\"$phy\"}" 2>/dev/null | head -c 65537)"
    [ "${#payload}" -le 65536 ] || exit 0
    json_load "$payload" >/dev/null 2>&1 || exit 0
    json_select results >/dev/null 2>&1 || exit 0
    json_get_keys keys || exit 0
    band="$(uci_get "wireless.$radio.band")"
    [ -n "$band" ] || band="$(uci_get "wireless.$radio.hwmode")"
    count=0
    for key in $keys; do
        count=$((count + 1))
        [ "$count" -le 256 ] || break
        json_select "$key" >/dev/null 2>&1 || continue
        channel=""; mhz=""; restricted=""
        json_get_var channel channel || true
        json_get_var mhz mhz || true
        json_get_var restricted restricted || true
        json_select ..
        [ "$restricted" = 0 ] || continue
        case "$channel:$mhz" in *[!0-9:]*|:*|*:) continue ;; esac
        [ "$channel" -ge 1 ] && [ "$channel" -le 233 ] || continue
        case "$band" in
            2g|11g|11ng) [ "$mhz" -ge 2400 ] && [ "$mhz" -lt 2500 ] || continue ;;
            5g|11a|11na) [ "$mhz" -ge 4900 ] && [ "$mhz" -lt 5925 ] || continue ;;
            6g) [ "$mhz" -ge 5925 ] && [ "$mhz" -le 7125 ] || continue ;;
            *) continue ;;
        esac
        printf '%s\n' "$channel"
    done
)

wifi_channels_json() {
    local radio first channels
    first=1
    printf '{"app":"sheepfold","radios":{'
    for radio in $(sections_of_config_type wireless wifi-device | head -n 4); do
        [ "$first" = 1 ] || printf ','
        first=0
        json_string "$radio"
        printf ':['
        channels="$(wifi_channel_list "$radio" | sort -nu)"
        printf '%s\n' "$channels" | awk 'NF { if (seen++) printf ","; printf "%d", $1 }'
        printf ']'
    done
    printf '}}\n'
}

wifi_save_cleanup() {
    local status="${1:-1}" keep_snapshot=0
    trap - EXIT HUP INT TERM
    if [ "$WIFI_TX_RESTORE" = 1 ]; then
        if ! restore_config_snapshot "$WIFI_TX_SNAPSHOT" "$WIRELESS_CONFIG_FILE"; then
            keep_snapshot=1
            status=72
            report_recovery_failure config_rollback_failed "$WIFI_TX_DIR"
        elif ! "$WIFI_BIN" reload >/dev/null 2>&1 && ! "$WIFI_BIN" >/dev/null 2>&1; then
            # Файл восстановлен, но подтверждения работающего Wi-Fi нет.
            keep_snapshot=1
            status=73
            report_recovery_failure wifi_rollback_apply_failed "$WIFI_TX_DIR"
        fi
    fi
    [ "$keep_snapshot" = 1 ] || [ -z "$WIFI_TX_DIR" ] || rm -rf "$WIFI_TX_DIR" 2>/dev/null || true
    [ "$WIFI_TX_ACTIVE" = 0 ] || sheepfold_lock_release
    exit "$status"
}

valid_wifi_ssid() (
    # Лимит SSID задан в октетах, не в символах UTF-8. Пробелы — часть имени.
    LC_ALL=C
    export LC_ALL
    [ -n "${1:-}" ] && valid_plain_text "$1" 32
)

valid_wifi_psk() (
    local key
    LC_ALL=C
    export LC_ALL
    key="${1:-}"
    # WPA-PSK: фраза 8–63 байта либо ровно 64 hex-символа готового ключа.
    # Не переносим эти ограничения на чистый SAE или enterprise/WEP.
    if [ "${#key}" -eq 64 ]; then
        case "$key" in *[!0-9a-fA-F]*) return 1 ;; *) return 0 ;; esac
    fi
    [ "${#key}" -ge 8 ] && [ "${#key}" -le 63 ]
)

valid_wifi_encryption() {
    case "${1:-}" in
        none|owe|wep|psk|psk2|psk-mixed|sae|sae-mixed|wpa|wpa2|wpa3|wpa3-mixed) return 0 ;;
        *) return 1 ;;
    esac
}

valid_wifi_channel() {
    local value
    value="${1:-}"
    [ "$value" = auto ] && return 0
    printf '%s' "$value" | grep -Eq '^[0-9]{1,3}$' || return 1
    [ "$value" -ge 1 ] && [ "$value" -le 233 ]
}

wifi_state_is_valid() {
    local section device ssid password encryption channel enabled
    section="$1"
    device="$2"
    ssid="$3"
    password="$4"
    encryption="$5"
    channel="$6"
    enabled="$7"
    [ "$(uci_get "wireless.$section")" = wifi-iface ] &&
        [ "$(uci_get "wireless.$section.ssid")" = "$ssid" ] &&
        [ "$(uci_get "wireless.$section.encryption")" = "$encryption" ] &&
        [ "$(uci_get "wireless.$device.channel")" = "$channel" ] || return 1
    if [ "$enabled" = 1 ]; then
        [ "$(uci_get "wireless.$section.disabled")" != 1 ] &&
            [ "$(uci_get "wireless.$device.disabled")" != 1 ] || return 1
    else
        [ "$(uci_get "wireless.$section.disabled")" = 1 ] || return 1
    fi
    if [ "$encryption" = none ] || [ "$encryption" = owe ]; then
        [ -z "$(uci_get "wireless.$section.key")" ]
    else
        [ "$(uci_get "wireless.$section.key")" = "$password" ]
    fi
}

wifi_save() {
    local body expected_wifi_revision current_wifi_revision section device ssid password
    local encryption channel enabled confirm
    body="$(cat)"
    expected_wifi_revision="$(form_get expectedWifiRevision "$body")"
    section="$(form_get section "$body")"
    ssid="$(form_get ssid "$body")"
    password="$(form_get password "$body")"
    encryption="$(form_get encryption "$body")"
    channel="$(form_get channel "$body")"
    enabled="$(form_get enabled "$body")"
    confirm="$(form_get confirm "$body")"

    [ -n "$expected_wifi_revision" ] || {
        printf '%s\n' wifi_revision_required >&2
        return 2
    }
    valid_section_name "$section" && [ "$(uci_get "wireless.$section")" = wifi-iface ] || {
        printf '%s\n' wifi_network_not_found >&2
        return 2
    }
    device="$(uci_get "wireless.$section.device")"
    valid_section_name "$device" && [ "$(uci_get "wireless.$device")" = wifi-device ] || {
        printf '%s\n' wifi_radio_not_found >&2
        return 2
    }
    valid_wifi_ssid "$ssid" || {
        printf '%s\n' invalid_wifi_ssid >&2
        return 2
    }
    valid_plain_text "$password" 128 || {
        printf '%s\n' invalid_wifi_password >&2
        return 2
    }
    valid_wifi_encryption "$encryption" || {
        printf '%s\n' invalid_wifi_encryption >&2
        return 2
    }
    # OWE шифрует соединение без общего пароля, как отдельный режим, не PSK.
    [ "$encryption" = none ] || [ "$encryption" = owe ] || [ -n "$password" ] || {
        printf '%s\n' wifi_password_required >&2
        return 2
    }
    case "$encryption" in
        psk|psk2|psk-mixed)
            valid_wifi_psk "$password" || {
                printf '%s\n' invalid_wifi_password >&2
                return 2
            }
            ;;
    esac
    valid_wifi_channel "$channel" || {
        printf '%s\n' invalid_wifi_channel >&2
        return 2
    }
    valid_flag "$enabled" || {
        printf '%s\n' invalid_wifi_enabled >&2
        return 2
    }
    [ "$enabled" = 1 ] || [ "$confirm" = 1 ] || {
        printf '%s\n' confirmation_required >&2
        return 2
    }

    sheepfold_lock_acquire "$LOCK_FILE" 30 || {
        printf '%s\n' config_busy >&2
        return 4
    }
    WIFI_TX_ACTIVE=1
    trap 'wifi_save_cleanup $?' EXIT
    trap 'exit 129' HUP
    trap 'exit 130' INT
    trap 'exit 143' TERM

    current_wifi_revision="$(wifi_revision)" || return 70
    [ "$current_wifi_revision" = "$expected_wifi_revision" ] || {
        printf '%s\n' revision_conflict >&2
        return 3
    }
    [ "$(uci_get "wireless.$section")" = wifi-iface ] || {
        printf '%s\n' wifi_network_not_found >&2
        return 2
    }

    # Сохранить прежний канал можно и без iwinfo, но новый числовой канал требует проверки
    if [ "$channel" != auto ] && [ "$channel" != "$(uci_get "wireless.$device.channel")" ]; then
        wifi_channel_list "$device" | grep -Fxq "$channel" || {
            printf '%s\n' invalid_wifi_channel >&2
            return 2
        }
    fi

    mkdir -p "$TRANSACTION_ROOT"
    chmod 700 "$TRANSACTION_ROOT" 2>/dev/null || true
    WIFI_TX_DIR="$TRANSACTION_ROOT/wifi.$$"
    WIFI_TX_SNAPSHOT="$WIFI_TX_DIR/wireless.before"
    (umask 077; mkdir "$WIFI_TX_DIR") || return 70
    cp -p "$WIRELESS_CONFIG_FILE" "$WIFI_TX_SNAPSHOT" || return 70
    WIFI_TX_RESTORE=1

    uci_read -q set "wireless.$section.ssid=$ssid"
    uci_read -q set "wireless.$section.encryption=$encryption"
    uci_read -q set "wireless.$device.channel=$channel"
    if [ "$enabled" = 1 ]; then
        uci_read -q delete "wireless.$section.disabled" 2>/dev/null || true
        uci_read -q delete "wireless.$device.disabled" 2>/dev/null || true
    else
        uci_read -q set "wireless.$section.disabled=1"
    fi
    if [ "$encryption" = none ] || [ "$encryption" = owe ]; then
        uci_read -q delete "wireless.$section.key" 2>/dev/null || true
    else
        uci_read -q set "wireless.$section.key=$password"
    fi
    uci_read -q commit wireless || {
        printf '%s\n' config_commit_failed >&2
        return 70
    }
    wifi_state_is_valid "$section" "$device" "$ssid" "$password" "$encryption" "$channel" "$enabled" || {
        printf '%s\n' config_verify_failed >&2
        return 70
    }
    "$WIFI_BIN" reload >/dev/null 2>&1 || "$WIFI_BIN" >/dev/null 2>&1 || {
        printf '%s\n' wifi_reload_failed >&2
        return 5
    }

    WIFI_TX_RESTORE=0
    trap - EXIT HUP INT TERM
    rm -rf "$WIFI_TX_DIR"
    WIFI_TX_DIR=""
    sheepfold_lock_release
    WIFI_TX_ACTIVE=0
    audit_event "настройки Wi-Fi сохранены: $ssid"
    admin_config_json wifi-save 1
}

wifi_control() {
    local body enable confirm
    body="$(cat)"
    enable="$(form_get enable "$body")"
    confirm="$(form_get confirm "$body")"
    valid_flag "$enable" && [ "$confirm" = 1 ] || {
        printf '%s\n' confirmation_required >&2
        return 2
    }
    if [ "$enable" = 1 ]; then
        SHEEPFOLD_ACTION_ACTOR="Android ($ADMIN_LOGIN)" "$ROUTER_CONTROL" wifi-enable >/dev/null 2>&1 || {
            printf '%s\n' wifi_control_failed >&2
            return 5
        }
    else
        SHEEPFOLD_ACTION_ACTOR="Android ($ADMIN_LOGIN)" "$ROUTER_CONTROL" wifi-disable >/dev/null 2>&1 || {
            printf '%s\n' wifi_control_failed >&2
            return 5
        }
    fi
    printf '{"app":"sheepfold","ok":true,"enabled":'
    [ "$enable" = 1 ] && printf true || printf false
    printf '}\n'
}

wifi_automation_save() {
    local body expected_revision schema_version enable_mode enable_time disable_mode disable_time confirm_risk
    body="$(cat)"
    expected_revision="$(form_get expectedRevision "$body")"
    schema_version="$(form_get schemaVersion "$body")"
    enable_mode="$(form_get enableMode "$body")"
    enable_time="$(form_get enableTime "$body")"
    disable_mode="$(form_get disableMode "$body")"
    disable_time="$(form_get disableTime "$body")"
    confirm_risk="$(form_get confirmRisk "$body")"

    case "$enable_mode" in never|time) ;; *) printf '%s\n' invalid_wifi_automation_mode >&2; return 2 ;; esac
    case "$disable_mode" in never|time) ;; *) printf '%s\n' invalid_wifi_automation_mode >&2; return 2 ;; esac
    valid_time "$enable_time" || { printf '%s\n' invalid_wifi_automation_time >&2; return 2; }
    valid_time "$disable_time" || { printf '%s\n' invalid_wifi_automation_time >&2; return 2; }
    [ "$disable_mode" != time ] || [ "$confirm_risk" = 1 ] || {
        printf '%s\n' confirmation_required >&2
        return 2
    }

    begin_transaction "$expected_revision" "$schema_version" || return "$?"
    tx_uci -q set "sheepfold.global.wifi_auto_enable_mode=$enable_mode"
    tx_uci -q set "sheepfold.global.wifi_auto_enable_time=$enable_time"
    tx_uci -q set "sheepfold.global.wifi_auto_disable_mode=$disable_mode"
    tx_uci -q set "sheepfold.global.wifi_auto_disable_time=$disable_time"
    commit_transaction || { printf '%s\n' config_commit_failed >&2; return 70; }
    [ "$(uci_get sheepfold.global.wifi_auto_enable_mode)" = "$enable_mode" ] &&
        [ "$(uci_get sheepfold.global.wifi_auto_enable_time)" = "$enable_time" ] &&
        [ "$(uci_get sheepfold.global.wifi_auto_disable_mode)" = "$disable_mode" ] &&
        [ "$(uci_get sheepfold.global.wifi_auto_disable_time)" = "$disable_time" ] || {
        printf '%s\n' config_verify_failed >&2
        return 70
    }
    confirm_transaction
    audit_event "расписание Wi-Fi сохранено"
    admin_config_json wifi-automation-save 1
}
