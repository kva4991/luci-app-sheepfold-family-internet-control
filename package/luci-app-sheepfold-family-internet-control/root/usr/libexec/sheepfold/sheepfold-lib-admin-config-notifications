#!/bin/sh

# Настройки уведомлений родительского API образуют отдельную небольшую область.
# Они используют общий revision/transaction contract и не применяют runtime сами. §apicon1

notification_settings_save() {
	local body expected_revision schema_version sim_change_mode child_wifi_mode
    body="$(cat)"
    expected_revision="$(form_get expectedRevision "$body")"
    schema_version="$(form_get schemaVersion "$body")"
    sim_change_mode="$(form_get simChangeMode "$body")"
    child_wifi_mode="$(form_get childWifiMode "$body")"

    case "$sim_change_mode" in all|new_only|off) ;; *) printf '%s\n' invalid_sim_change_mode >&2; return 2 ;; esac
    case "$child_wifi_mode" in with_location|network_only|off) ;; *) printf '%s\n' invalid_child_wifi_mode >&2; return 2 ;; esac
    begin_transaction "$expected_revision" "$schema_version" || return "$?"
    tx_uci -q set "sheepfold.global.sim_change_notifications=$sim_change_mode"
    tx_uci -q set "sheepfold.global.child_wifi_network_notifications=$child_wifi_mode"
    commit_transaction || {
        printf '%s\n' config_commit_failed >&2
        return 70
    }
    [ "$(uci_get sheepfold.global.sim_change_notifications)" = "$sim_change_mode" ] &&
        [ "$(uci_get sheepfold.global.child_wifi_network_notifications)" = "$child_wifi_mode" ] || {
        printf '%s\n' config_verify_failed >&2
        return 70
    }
    confirm_transaction
    audit_event "настройки уведомлений сохранены"
    admin_config_json notification-settings-save 1
}
