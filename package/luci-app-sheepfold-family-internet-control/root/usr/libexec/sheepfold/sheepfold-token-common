#!/bin/sh
# Общие функции хранения и проверки административных Bearer-токенов.

token_normalize_mac() { printf '%s' "$1" | tr 'a-z' 'A-Z'; }

token_valid_mac() { printf '%s' "$1" | grep -Eq '^([0-9A-F]{2}:){5}[0-9A-F]{2}$'; }

# Для обычного административного API ожидаемый MAC приходит из server-side
# bound-token. Helper всегда подтверждает источник сам по DHCP/neighbor; значение
# от клиента допустимо лишь в старом внутреннем контракте и не считается доверием.
token_mac_for_ip() {
	client_ip="$1"
	observed_mac=""
	[ -n "$client_ip" ] || return 1

	if [ -r /tmp/dhcp.leases ]; then
		observed_mac="$(awk -v ip="$client_ip" '$3 == ip { print toupper($2); exit }' /tmp/dhcp.leases)"
	fi
	if ! token_valid_mac "$observed_mac"; then
		observed_mac="$(ip neigh show "$client_ip" 2>/dev/null | awk '{ for (i = 1; i <= NF; i++) if ($i == "lladdr") { print toupper($(i + 1)); exit } }')"
	fi
	token_valid_mac "$observed_mac" || return 1
	printf '%s\n' "$observed_mac"
}

token_request_source_matches() {
	client_ip="$1"
	claimed_mac="$(token_normalize_mac "$2")"
	token_valid_mac "$claimed_mac" || return 1
	observed_mac="$(token_mac_for_ip "$client_ip")" || return 1
	[ "$observed_mac" = "$claimed_mac" ]
}

token_file_get() {
	file="$1"
	key="$2"
	[ -r "$file" ] || return 1
	sed -n "s/^${key}=//p" "$file" | sed -n '1p'
}

# Legacy — только исторический пустой обычный файл. Ошибка чтения или
# повреждённая непустая запись не должны включать более слабую совместимость.
token_file_is_legacy() {
	[ -f "$1" ] && [ ! -L "$1" ] && [ -r "$1" ] && [ ! -s "$1" ]
}

# Читаем все поля за один проход и используем их только после успешного EOF.
# Ни source/eval, ни отдельные sed-чтения: дубли и частичный вывод не являются
# привязкой. 4 = повреждённая/устаревшая запись; 5 = отказ читающего backend.
token_load_bound_file() {
	local file parsed parse_status field value
	file="$1"
	TOKEN_RECORD_LOGIN='' TOKEN_RECORD_DEVICE_ID='' TOKEN_RECORD_MAC=''
	TOKEN_RECORD_ISSUED_AT='' TOKEN_RECORD_EXPIRES_AT=''
	[ -f "$file" ] && [ ! -L "$file" ] || return 4
	[ -r "$file" ] || return 5
	parse_status=0
	parsed="$(LC_ALL=C awk '
		{
			separator = index($0, "=")
			key = substr($0, 1, separator - 1)
			value = substr($0, separator + 1)
			if (!separator || key !~ /^(login|device_id|mac|issued_at|expires_at)$/ ||
				seen[key]++ || $0 ~ /[[:cntrl:]]/) invalid = 1
			values[key] = value
		}
		END {
			if (invalid || seen["login"] != 1 || seen["device_id"] != 1 ||
				seen["mac"] != 1 || seen["issued_at"] != 1 || seen["expires_at"] != 1 ||
				values["login"] !~ /^[A-Za-z0-9_.@+-]+$/ ||
				values["device_id"] !~ /^[A-Za-z0-9_.:-]+$/ ||
				values["issued_at"] !~ /^[0-9]+$/ || values["expires_at"] !~ /^[0-9]+$/) exit 42
			mac = toupper(values["mac"])
			if (split(mac, octets, ":") != 6) exit 42
			for (i = 1; i <= 6; i++) if (octets[i] !~ /^[0-9A-F][0-9A-F]$/) exit 42
			printf "login=%s\ndevice_id=%s\nmac=%s\nissued_at=%s\nexpires_at=%s\n", \
				values["login"], values["device_id"], mac, values["issued_at"], values["expires_at"]
		}' "$file")" || parse_status=$?
	case "$parse_status" in 0) ;; 42) return 4 ;; *) return 5 ;; esac
	# Не pipe: значения должны остаться в текущей функции, а не subshell цикла.
	while IFS='=' read -r field value; do
		case "$field" in
			login) TOKEN_RECORD_LOGIN="$value" ;;
			device_id) TOKEN_RECORD_DEVICE_ID="$value" ;;
			mac) TOKEN_RECORD_MAC="$value" ;;
			issued_at) TOKEN_RECORD_ISSUED_AT="$value" ;;
			expires_at) TOKEN_RECORD_EXPIRES_AT="$value" ;;
		esac
	done <<EOF_TOKEN_RECORD
$parsed
EOF_TOKEN_RECORD
	[ -n "$TOKEN_RECORD_LOGIN" ] && [ -n "$TOKEN_RECORD_DEVICE_ID" ] &&
		[ -n "$TOKEN_RECORD_MAC" ] && [ -n "$TOKEN_RECORD_ISSUED_AT" ] &&
		[ -n "$TOKEN_RECORD_EXPIRES_AT" ] || return 5
	return 0
}

# Публикует только новую запись. Subshell изолирует переменные/umask/trap от pairing.
# Существующий токен никогда не заменяется: даже редкая коллизия не отзывает чужой вход.
token_write_bound_file() (
	dir="$1"
	hash="$2"
	login="$3"
	device_id="$4"
	mac="$(token_normalize_mac "$5")" || return 1
	issued_at="$6"
	expires_at="$7"
	case "$hash" in ''|*[!0-9a-f]*) return 1 ;; esac
	[ "${#hash}" -eq 64 ] || return 1
	case "$login" in ''|*[!A-Za-z0-9_.@+-]*) return 1 ;; esac
	case "$device_id" in ''|*[!0-9]*|0*) return 1 ;; esac
	token_valid_mac "$mac" || return 1
	case "$issued_at" in ''|*[!0-9]*) return 1 ;; esac
	case "$expires_at" in ''|*[!0-9]*) return 1 ;; esac

	umask 077
	stage_dir="$(mktemp -d "$dir/.token.XXXXXX")" || return 1
	tmp="$stage_dir/record"
	trap 'rm -f "$tmp" 2>/dev/null; rmdir "$stage_dir" 2>/dev/null || true' EXIT
	trap 'exit 129' HUP
	trap 'exit 130' INT
	trap 'exit 143' TERM
	# Один printf и явные проверки нужны даже при вызове всей функции из if !.
	printf 'login=%s\ndevice_id=%s\nmac=%s\nissued_at=%s\nexpires_at=%s\n' \
		"$login" "$device_id" "$mac" "$issued_at" "$expires_at" > "$tmp" || return 1
	chmod 600 "$tmp" || return 1
	# -T запрещает трактовать существующий каталог/ссылку как папку назначения.
	# link в той же файловой системе публикует готовый inode без замены получателя.
	ln -T "$tmp" "$dir/$hash" || return 1
	return 0
)

token_device_is_admin_paired() {
	local wanted_id wanted_mac section device_id legacy_ids mac admin
	wanted_id="$1"
	wanted_mac="$(token_normalize_mac "$2")"

	token_valid_mac "$wanted_mac" || return 1
	[ -n "$wanted_id" ] || return 1
	for section in $(uci -q show sheepfold 2>/dev/null | sed -n 's/^sheepfold\.\([^.=]*\)=device$/\1/p'); do
		admin="$(uci -q get "sheepfold.$section.admin_device" 2>/dev/null || printf 0)"
		[ "$admin" = 1 ] || continue
		mac="$(token_normalize_mac "$(uci -q get "sheepfold.$section.mac" 2>/dev/null || true)")"
		[ "$mac" = "$wanted_mac" ] || continue
		# Обычная авторизация не должна повторять полный обход и commit allocator
		# для каждой записи; старый формат восстанавливаем только у нужного телефона
		device_id="$(uci -q get "sheepfold.$section.id" 2>/dev/null || true)"
		case "$device_id" in
			''|*[!0-9]*|0*) device_id="$(/usr/libexec/sheepfold/sheepfold-device-id ensure "$section" 2>/dev/null || true)" ;;
		esac
		[ -n "$device_id" ] || continue
		legacy_ids="$(uci -q get "sheepfold.$section.legacy_ids" 2>/dev/null || true)"
		# После миграции старого формата номера старый APK продолжает работать только
		# с прежним ID из своего токена и с тем же проверенным MAC. §deviceid2
		case " $device_id $legacy_ids " in
			*" $wanted_id "*) ;;
			*) continue ;;
		esac
		return 0
	done
	return 1
}

token_bound_file_valid() {
	local file client_device_id client_mac now login device_id mac issued_at expires_at normalized_client_mac expected_login
	file="$1"
	client_device_id="$2"
	client_mac="$3"
	now="${4:-$(date +%s)}"
	expected_login="${5:-}"
	[ -n "$client_device_id" ] || return 1
	normalized_client_mac="$(token_normalize_mac "$client_mac")"
	token_valid_mac "$normalized_client_mac" || return 1
	case "$now" in ''|*[!0-9]*) return 1 ;; esac

	if token_file_is_legacy "$file"; then
		token_device_is_admin_paired "$client_device_id" "$normalized_client_mac"
		return $?
	fi

	token_load_bound_file "$file" || return 1
	login="$TOKEN_RECORD_LOGIN"
	device_id="$TOKEN_RECORD_DEVICE_ID"
	mac="$TOKEN_RECORD_MAC"
	issued_at="$TOKEN_RECORD_ISSUED_AT"
	expires_at="$TOKEN_RECORD_EXPIRES_AT"
	# Имя hash-файла вычислено для конкретного логина; метаданные обязаны совпасть.
	[ -z "$expected_login" ] || [ "$login" = "$expected_login" ] || return 1
	[ "$expires_at" -le 0 ] || [ "$now" -le "$expires_at" ] || return 1
	[ "$client_device_id" = "$device_id" ] || return 1
	[ "$normalized_client_mac" = "$mac" ] || return 1
	token_device_is_admin_paired "$device_id" "$mac"
}
