{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sheepfold.example/schemas/ai/request-envelope.schema.json",
  "title": "AI request envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestId",
    "tenantId",
    "sessionId",
    "audience",
    "ageBand",
    "locale",
    "countryProfile",
    "message",
    "history",
    "allowedMemoryScopes",
    "privacyScope",
    "payloadClass",
    "processingPurpose",
    "providerId",
    "consentProof",
    "privacyProof",
    "issuedAt",
    "expiresAt",
    "autoMode"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "requestId": { "type": "string", "minLength": 8, "maxLength": 80 },
    "tenantId": { "type": "string", "minLength": 8, "maxLength": 80, "description": "Opaque server-side tenant pseudonym, not a local family identifier." },
    "sessionId": { "type": "string", "minLength": 8, "maxLength": 80, "description": "Opaque session pseudonym without local account data." },
    "audience": { "enum": ["parent", "child", "family"] },
    "ageBand": { "enum": ["unknown", "under7", "7to10", "11to14", "15to17", "adult"] },
    "locale": { "type": "string", "minLength": 2, "maxLength": 20 },
    "countryProfile": { "type": "string", "minLength": 2, "maxLength": 40 },
    "message": { "type": "string", "minLength": 1, "maxLength": 12000 },
    "history": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "text"],
        "properties": {
          "role": { "enum": ["user", "assistant"] },
          "text": { "type": "string", "maxLength": 12000 }
        }
      }
    },
    "allowedMemoryScopes": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["self", "familyShared", "sessionOnly"] }
    },
    "privacyScope": { "enum": ["oneOff", "longitudinal"] },
    "payloadClass": { "enum": ["general", "sensitive", "childSensitive", "healthSensitive"] },
    "processingPurpose": {
      "enum": ["generalSupport", "familySupport", "education", "healthScreening", "routerAssistance", "safetySupport"]
    },
    "providerId": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9._:-]{2,80}$",
      "description": "External or server-side provider adapter selected by the signed router policy."
    },
    "consentProof": { "type": "string", "minLength": 8, "maxLength": 500 },
    "privacyProof": { "type": "string", "minLength": 8, "maxLength": 500 },
    "issuedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "autoMode": { "type": "boolean" }
  }
}
