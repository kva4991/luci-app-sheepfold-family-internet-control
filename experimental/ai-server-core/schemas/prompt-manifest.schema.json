{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sheepfold.example/schemas/ai/prompt-manifest.schema.json",
  "title": "Versioned prompt block manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "manifestId", "createdAt", "status", "blocks"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "manifestId": { "type": "string", "minLength": 8, "maxLength": 100 },
    "createdAt": { "type": "string", "format": "date-time" },
    "status": { "enum": ["draft", "approved", "revoked"] },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["blockId", "version", "role", "file", "sha256", "owner", "approvedAt", "compatibleSchemas"],
        "properties": {
          "blockId": { "type": "string", "minLength": 3, "maxLength": 100 },
          "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
          "role": { "enum": ["corePolicy", "domainPolicy", "reviewer", "composer"] },
          "file": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+$", "maxLength": 300 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "owner": { "type": "string", "minLength": 2, "maxLength": 100 },
          "approvedAt": { "type": ["string", "null"], "format": "date-time" },
          "compatibleSchemas": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "integer", "minimum": 1 }
          }
        }
      }
    }
  }
}
