{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sheepfold.example/schemas/ai/evidence-record.schema.json",
  "title": "Evidence record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "evidenceId",
    "title",
    "publisher",
    "url",
    "sourceKind",
    "jurisdictions",
    "ageBands",
    "claims",
    "licenseNote",
    "contentHash",
    "checkedAt",
    "validUntil",
    "status"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "evidenceId": { "type": "string", "minLength": 3, "maxLength": 100 },
    "title": { "type": "string", "maxLength": 500 },
    "publisher": { "type": "string", "maxLength": 200 },
    "url": { "type": "string", "format": "uri", "pattern": "^https://", "maxLength": 2000 },
    "sourceKind": { "enum": ["officialGuidance", "law", "systematicReview", "primaryStudy", "technicalStandard", "providerDocs", "projectPolicy"] },
    "jurisdictions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "maxLength": 40 } },
    "ageBands": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "maxLength": 40 } },
    "claims": { "type": "array", "minItems": 1, "maxItems": 30, "uniqueItems": true, "items": { "type": "string", "maxLength": 1200 } },
    "licenseNote": { "type": "string", "maxLength": 500 },
    "contentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "checkedAt": { "type": "string", "format": "date-time" },
    "validUntil": { "type": "string", "format": "date-time" },
    "status": { "enum": ["active", "reviewDue", "revoked"] }
  }
}
