{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sheepfold.example/schemas/ai/response-plan.schema.json",
  "title": "Reviewed response plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "outcome",
    "answer",
    "facts",
    "hypotheses",
    "citations",
    "uncertainty",
    "questions",
    "nextSteps",
    "avoid",
    "foreseeableActions",
    "actionDrafts",
    "memoryDrafts",
    "reviewStatus"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "outcome": { "enum": ["answer", "clarify", "safeFallback", "refuse", "humanReview"] },
    "answer": { "type": "string", "maxLength": 12000 },
    "facts": { "type": "array", "maxItems": 30, "items": { "type": "string", "maxLength": 1200 } },
    "hypotheses": { "type": "array", "maxItems": 10, "items": { "type": "string", "maxLength": 1200 } },
    "citations": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim", "evidenceIds"],
        "properties": {
          "claim": { "type": "string", "minLength": 1, "maxLength": 1200, "description": "Must exactly match one item from facts." },
          "evidenceIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "maxLength": 100 } }
        }
      }
    },
    "uncertainty": { "type": "array", "maxItems": 12, "items": { "type": "string", "maxLength": 1000 } },
    "questions": { "type": "array", "maxItems": 3, "items": { "type": "string", "maxLength": 500 } },
    "nextSteps": { "type": "array", "maxItems": 8, "items": { "type": "string", "maxLength": 800 } },
    "avoid": { "type": "array", "maxItems": 8, "items": { "type": "string", "maxLength": 800 } },
    "foreseeableActions": { "type": "array", "maxItems": 3, "items": { "type": "string", "maxLength": 800 } },
    "actionDrafts": { "type": "array", "maxItems": 5, "items": { "$ref": "action-draft.schema.json" } },
    "memoryDrafts": { "type": "array", "maxItems": 8, "items": { "$ref": "memory-draft.schema.json" } },
    "reviewStatus": { "enum": ["unreviewed", "pass", "revise", "safeFallback", "needsClarification", "needsHumanReview"] }
  }
}
