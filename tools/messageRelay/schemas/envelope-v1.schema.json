{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sheepfold.invalid/schemas/family-message-relay/envelope-v1.schema.json",
  "title": "Sheepfold family message relay envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "cryptoSuite",
    "direction",
    "messageClass",
    "routerId",
    "phoneId",
    "streamId",
    "messageId",
    "sequence",
    "issuedAt",
    "expiresAt",
    "keyId",
    "ciphertext"
  ],
  "properties": {
    "protocolVersion": { "const": 1 },
    "cryptoSuite": { "const": "HMAC-SHA256+AES-256-GCM" },
    "direction": { "enum": ["phoneToRouter", "routerToPhone"] },
    "messageClass": { "enum": ["command", "commandResult", "notification"] },
    "routerId": { "$ref": "#/$defs/id" },
    "phoneId": { "$ref": "#/$defs/id" },
    "streamId": { "$ref": "#/$defs/id" },
    "messageId": { "$ref": "#/$defs/id" },
    "sequence": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "issuedAt": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "expiresAt": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "keyId": { "$ref": "#/$defs/id" },
    "ciphertext": { "type": "string", "pattern": "^[A-Za-z0-9_-]{23,10944}$" }
  },
  "allOf": [
    {
      "if": { "properties": { "messageClass": { "const": "command" } }, "required": ["messageClass"] },
      "then": { "properties": { "direction": { "const": "phoneToRouter" } } },
      "else": { "properties": { "direction": { "const": "routerToPhone" } } }
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{21}[AQgw]$" }
  }
}
