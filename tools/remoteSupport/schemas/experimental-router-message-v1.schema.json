{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sheepfold.example/schemas/remote-support/experimental-router-message-v1.schema.json",
  "title": "Experimental support control: strict router messages",
  "description": "Unreleased experimental profile. Not permission to activate remote support. Common signatures, canonical IDs, stream/sequence/deadline/identity checks remain mandatory in runtime.",
  "allOf": [
    {
      "$ref": "signed-payload-v1.schema.json"
    },
    {
      "oneOf": [
        {
          "properties": {
            "messageType": {
              "const": "enrollProof"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "challenge",
                "clientNonce"
              ],
              "properties": {
                "challenge": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{43}$"
                },
                "clientNonce": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{22}$"
                }
              }
            }
          },
          "required": [
            "messageType",
            "payload"
          ]
        },
        {
          "properties": {
            "messageType": {
              "const": "capabilityReport"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "profile",
                "capabilities"
              ],
              "properties": {
                "profile": {
                  "const": "sheepfold-support-server-experimental-1"
                },
                "capabilities": {
                  "type": "array",
                  "uniqueItems": true,
                  "maxItems": 8,
                  "items": {
                    "enum": [
                      "claimV1",
                      "localRevokeV1",
                      "mutualTlsTransportV1",
                      "typedGatewayV1",
                      "safeApplyV1",
                      "transportCredentialsV1"
                    ]
                  }
                }
              }
            }
          },
          "required": [
            "messageType",
            "payload"
          ]
        },
        {
          "properties": {
            "messageType": {
              "const": "claimOpen"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "sessionId",
                "code",
                "claimExpiresAt",
                "routerHostKey",
                "diagnosticsAllowed"
              ],
              "properties": {
                "sessionId": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{22}$"
                },
                "code": {
                  "type": "string",
                  "pattern": "^[0-9]{12}$"
                },
                "claimExpiresAt": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "routerHostKey": {
                  "type": "string",
                  "pattern": "^ssh-ed25519 [A-Za-z0-9+/]{68}$"
                },
                "diagnosticsAllowed": {
                  "type": "boolean"
                }
              }
            }
          },
          "required": [
            "messageType",
            "payload"
          ]
        },
        {
          "properties": {
            "messageType": {
              "const": "sessionReady"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "sessionId",
                "leaseId",
                "bootId"
              ],
              "properties": {
                "sessionId": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{22}$"
                },
                "leaseId": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{22}$"
                },
                "bootId": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{22}$"
                }
              }
            }
          },
          "required": [
            "messageType",
            "payload"
          ]
        },
        {
          "properties": {
            "messageType": {
              "const": "heartbeat"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "sessionId",
                "leaseId",
                "bootId"
              ],
              "properties": {
                "sessionId": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{22}$"
                },
                "leaseId": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{22}$"
                },
                "bootId": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{22}$"
                }
              }
            }
          },
          "required": [
            "messageType",
            "payload"
          ]
        },
        {
          "properties": {
            "messageType": {
              "const": "revokeRequest"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "sessionId"
              ],
              "properties": {
                "sessionId": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{22}$"
                }
              }
            }
          },
          "required": [
            "messageType",
            "payload"
          ]
        },
        {
          "properties": {
            "messageType": {
              "const": "statusQuery"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "sessionId"
              ],
              "properties": {
                "sessionId": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{22}$"
                }
              }
            }
          },
          "required": [
            "messageType",
            "payload"
          ]
        }
      ]
    }
  ]
}
