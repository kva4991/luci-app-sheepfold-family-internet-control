{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sheepfold.example/schemas/remote-support/experimental-server-message-v1.schema.json",
  "title": "Experimental support control: implemented server responses",
  "description": "Default loopback runtime only. claimAccepted/sessionActive/transport are deliberately excluded until the real broker and its wire profile are implemented; a synthetic unit broker is not this API.",
  "allOf": [
    {
      "$ref": "signed-payload-v1.schema.json"
    },
    {
      "oneOf": [
        {
          "properties": {
            "messageType": {
              "const": "enrollChallenge"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "challenge",
                "clientNonce",
                "candidateKeyId",
                "profile"
              ],
              "properties": {
                "challenge": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{43}$"
                },
                "clientNonce": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{22}$"
                },
                "candidateKeyId": {
                  "type": "string",
                  "pattern": "^router-[a-f0-9]{40}$"
                },
                "profile": {
                  "const": "sheepfold-support-server-experimental-1"
                }
              }
            }
          },
          "required": [
            "messageType",
            "payload"
          ]
        },
        {
          "properties": {
            "messageType": {
              "const": "enrollAccepted"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "routerId",
                "keyId",
                "profile"
              ],
              "properties": {
                "routerId": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{22}$"
                },
                "keyId": {
                  "type": "string",
                  "pattern": "^router-[a-f0-9]{40}$"
                },
                "profile": {
                  "const": "sheepfold-support-server-experimental-1"
                }
              }
            }
          },
          "required": [
            "messageType",
            "payload"
          ]
        },
        {
          "properties": {
            "messageType": {
              "const": "statusQuery"
            },
            "payload": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "sessionId",
                    "state",
                    "claimExpiresAt",
                    "accessExpiresAt",
                    "leaseExpiresAt",
                    "ticketId"
                  ],
                  "properties": {
                    "sessionId": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-]{22}$"
                    },
                    "state": {
                      "enum": [
                        "claimOpen",
                        "claimBlocked",
                        "claimExpired",
                        "sessionPreparing",
                        "revoked",
                        "sessionExpired",
                        "securityBlocked"
                      ]
                    },
                    "claimExpiresAt": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "accessExpiresAt": {
                      "oneOf": [
                        {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "leaseExpiresAt": {
                      "enum": [
                        null,
                        0
                      ]
                    },
                    "ticketId": {
                      "oneOf": [
                        {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "profile",
                    "capabilities"
                  ],
                  "properties": {
                    "profile": {
                      "const": "sheepfold-support-server-experimental-1"
                    },
                    "capabilities": {
                      "type": "array",
                      "uniqueItems": true,
                      "maxItems": 1,
                      "items": {
                        "const": "claimV1"
                      }
                    }
                  }
                }
              ]
            }
          },
          "required": [
            "messageType",
            "payload"
          ]
        },
        {
          "properties": {
            "messageType": {
              "const": "claimOpened"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "sessionId",
                "state",
                "claimExpiresAt",
                "accessExpiresAt",
                "leaseExpiresAt",
                "ticketId"
              ],
              "properties": {
                "sessionId": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{22}$"
                },
                "state": {
                  "enum": [
                    "claimOpen",
                    "claimBlocked",
                    "claimExpired",
                    "sessionPreparing",
                    "revoked",
                    "sessionExpired",
                    "securityBlocked"
                  ]
                },
                "claimExpiresAt": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "accessExpiresAt": {
                  "oneOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "leaseExpiresAt": {
                  "enum": [
                    null,
                    0
                  ]
                },
                "ticketId": {
                  "oneOf": [
                    {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          },
          "required": [
            "messageType",
            "payload"
          ]
        },
        {
          "properties": {
            "messageType": {
              "const": "revokeConfirmed"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "sessionId",
                "state",
                "claimExpiresAt",
                "accessExpiresAt",
                "leaseExpiresAt",
                "ticketId"
              ],
              "properties": {
                "sessionId": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{22}$"
                },
                "state": {
                  "enum": [
                    "claimOpen",
                    "claimBlocked",
                    "claimExpired",
                    "sessionPreparing",
                    "revoked",
                    "sessionExpired",
                    "securityBlocked"
                  ]
                },
                "claimExpiresAt": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "accessExpiresAt": {
                  "oneOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "leaseExpiresAt": {
                  "enum": [
                    null,
                    0
                  ]
                },
                "ticketId": {
                  "oneOf": [
                    {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          },
          "required": [
            "messageType",
            "payload"
          ]
        }
      ]
    }
  ]
}
